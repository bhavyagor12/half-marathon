# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
!.env.example
*.tsbuildinfo
/.vercel-next/

# Local full-resolution avatar masters; optimized GLB is in public/models.
/output/avatar/*.glb

# Private original face references and intermediate head reconstruction
/output/avatar/head-v2/
