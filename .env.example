# Local: copy to .env.local. Production: set the same names in Vercel (Production). Never commit real secrets.
PAYMENTS_ENABLED=false
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_ENVIRONMENT=test_mode
SITE_URL=http://localhost:3001
SPONSOR_CONTACT=bhavya.gor9999@gmail.com
# Supabase project (tables and functions from supabase/migrations). The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret for operators to retry pending refunds (POST /api/admin/refunds).
REFUND_JOB_KEY=
# Vercel Cron sends this as a Bearer token to GET /api/admin/refunds; set it to the same value as REFUND_JOB_KEY.
CRON_SECRET=
