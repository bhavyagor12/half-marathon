# Local: copy to .env.local. Production: set the same names in Vercel (Production). Never commit real secrets.
PAYMENTS_ENABLED=false
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_ENVIRONMENT=test_mode
SITE_URL=http://localhost:3001
SPONSOR_CONTACT=bhavya.gor9999@gmail.com
# Supabase project (tables and functions from supabase/migrations). The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret for operators to retry pending refunds (POST /api/admin/refunds).
REFUND_JOB_KEY=
# Vercel Cron sends this as a Bearer token to GET /api/admin/refunds; set it to the same value as REFUND_JOB_KEY.
CRON_SECRET=
# Stablecoin refunds are paid out by an operator (GET/POST /api/admin/payouts) because Dodo's refund API takes no destination
# wallet. Set to true only after Dodo confirms API refunds for crypto_currency payments reach the payer.
DODO_STABLECOIN_API_REFUNDS=false
# USDC payments on Base (Base Pay). Setting a recipient address turns the "USDC on Base" option on.
BASE_PAY_RECIPIENT=
# true = Base Sepolia testnet (test USDC), false = Base mainnet.
BASE_PAY_TESTNET=false
# Optional: your own bundler/RPC URLs (e.g. from the CDP portal) to avoid public-endpoint rate limits.
BASE_BUNDLER_URL=
BASE_RPC_URL=
# Optional automatic refunds for Base payments, sent from a CDP server wallet account.
# The account named here must be the BASE_PAY_RECIPIENT address and hold a little ETH on Base for gas.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_REFUND_ACCOUNT=slowrun-payments
